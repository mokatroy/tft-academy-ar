{
  "name": "tft-academy-ar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --outfile=.smoke.cjs --loader:.json=json --log-level=error && node .smoke.cjs",
    "fetch-data": "python3 scripts/fetch_data.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
