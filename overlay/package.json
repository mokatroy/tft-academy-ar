{
  "name": "tft-academy-overlay",
  "productName": "TFT Academy Overlay",
  "private": true,
  "version": "0.1.0",
  "description": "Always-on-top Teamfight Tactics comp overlay powered by the TFT Academy dataset.",
  "author": "TFT Academy",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "start:dev": "electron . --dev",
    "test": "esbuild tests/all.test.ts --bundle --platform=node --format=esm --outfile=.test.mjs --loader:.json=json --log-level=error && node --test .test.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.tftacademy.overlay",
    "productName": "TFT Academy Overlay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TFT Academy Overlay"
    }
  }
}
